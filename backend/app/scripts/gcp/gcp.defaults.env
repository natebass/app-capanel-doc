# Shared defaults for Cloud Run deploy scripts.
# Override any value in .env, Cloud Build trigger env, or shell before invoking scripts.

DEFAULT_FULL_SERVICE="capanel-full"
DEFAULT_RUN_SERVICE_ACCOUNT="capanel-runner"
DEFAULT_CLOUD_SQL_INSTANCE="capanel-pg"
DEFAULT_CLOUD_SQL_DB="capanel"
DEFAULT_CLOUD_SQL_USER="capanel_app"
DEFAULT_PROJECT_NAME="California Accountability Panel"
DEFAULT_IMPORT_GCS_URI="gs://ca-panel-001-resources/resources"
DEFAULT_IMPORT_RESOURCES_LOCAL_PATH="$HOME/Downloads/resources"
DEFAULT_VPC_NETWORK="default"
DEFAULT_VPC_SUBNET="default"
DEFAULT_FRONTEND_HOST_PRODUCTION="https://localhost"
