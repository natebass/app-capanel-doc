{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"eslint",
		"react",
		"unicorn",
		"typescript",
		"oxc",
		"import",
		"jsdoc",
		"jest",
		"vitest",
		"jsx-a11y",
		"react-perf",
		"promise",
	],
	"jsPlugins": ["eslint-plugin-playwright", "eslint-plugin-react"],
	// Ignore patterns (from biome files.includes negations)
	"ignorePatterns": [
		"**/src/routeTree.gen.ts",
		"**/src/styles.css",
		"**/dist/**/*",
		"**/node_modules/**/*",
		"**/src/client/**/*",
		"**/playwright-report",
		"**/playwright.config.ts",
	],
	// Enable recommended rules (from biome linter.rules.recommended)
	"categories": {
		"correctness": "warn",
	},
	"rules": {
		"eslint/no-unused-vars": "error",
		// From biome suspicious rules
		"typescript/no-explicit-any": "off",
		"react/no-array-index-key": "off",
		// From biome style rules
		"typescript/no-non-null-assertion": "off",
		"eslint/no-param-reassign": "error",
		"react/self-closing-comp": "error",
		"eslint/no-else-return": "error",
	},
}
